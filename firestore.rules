rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Transaction Validation
    function isValidTransaction(data) {
      return data.keys().hasAll(['amount', 'category', 'type', 'date', 'time', 'note', 'userId', 'createdAt'])
        && data.keys().size() == 8
        && data.amount is number
        && data.amount > 0
        && data.category is string && data.category.size() <= 100
        && data.type in ['income', 'expense']
        && data.date is string
        && data.time is string
        && data.note is string && data.note.size() <= 500
        && data.userId == request.auth.uid
        && data.createdAt is string;
    }

    match /transactions/{transactionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidTransaction(incoming())
        && isValidId(transactionId);
        
      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && isValidTransaction(incoming())
        && incoming().userId == existing().userId
        && incoming().date == existing().date; // Keep date immutable if needed, or allow change
        
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
