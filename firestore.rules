rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'mohammadmahim2007@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt', 'lastLogin'])
        && data.displayName is string
        && data.email is string
        && data.createdAt is string
        && data.lastLogin is string;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Transaction Validation
    function isValidTransaction(data) {
      return data.keys().hasAll(['amount', 'category', 'type', 'date', 'time', 'note', 'userId', 'createdAt'])
        && data.keys().size() == 8
        && data.amount is number
        && data.amount > 0
        && data.category is string && data.category.size() <= 100
        && data.type in ['income', 'expense']
        && data.date is string
        && data.time is string
        && data.note is string && data.note.size() <= 500
        && data.userId == request.auth.uid
        && data.createdAt is string;
    }

    match /transactions/{transactionId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() 
        && isValidTransaction(incoming())
        && isValidId(transactionId);
        
      allow update: if isSignedIn()
        && (isOwner(existing().userId) || isAdmin())
        && isValidTransaction(incoming())
        && incoming().userId == existing().userId;
        
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    // Trash Validation
    function isValidTrash(data) {
      return data.keys().hasAll(['originalId', 'data', 'deletedAt', 'userId'])
        && data.keys().size() == 4
        && data.originalId is string
        && data.deletedAt is string
        && data.userId == request.auth.uid;
    }

    match /trash/{trashId} {
      allow list, get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidTrash(incoming()) && isValidId(trashId);
      allow update: if false;
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }
  }
}
