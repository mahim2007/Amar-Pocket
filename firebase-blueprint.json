{
  "entities": {
    "transaction": {
      "title": "Transaction",
      "description": "A financial transaction representing income or expense.",
      "type": "object",
      "properties": {
        "amount": { "type": "number", "description": "The amount of the transaction." },
        "category": { "type": "string", "description": "The category of the transaction." },
        "type": { "type": "string", "enum": ["income", "expense"], "description": "Whether it is income or expense." },
        "date": { "type": "string", "format": "date-time", "description": "ISO timestamp of the transaction." },
        "time": { "type": "string", "description": "Formatted time string (e.g. 10:30 AM)." },
        "note": { "type": "string", "description": "Optional note." },
        "userId": { "type": "string", "description": "ID of the user who owns this transaction." },
        "createdAt": { "type": "string", "format": "date-time", "description": "ISO timestamp of when the record was created." }
      },
      "required": ["amount", "category", "type", "date", "userId", "createdAt"]
    },
    "user": {
      "title": "User",
      "description": "User profile and metadata.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "blocked": { "type": "boolean" }
      }
    },
    "notification": {
      "title": "Notification",
      "description": "Global broadcast notifications.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "adminEmail": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "User transactions."
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles managed by admin."
    },
    "/notifications/{notificationId}": {
      "schema": "notification",
      "description": "System-wide broadcasts."
    }
  }
}
